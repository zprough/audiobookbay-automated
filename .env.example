# AudiobookBay Automated Configuration Example
# Copy this to .env and modify as needed

# AudiobookBay Settings
ABB_HOSTNAME=audiobookbay.lu
PAGE_LIMIT=5

# Download Client Settings
DOWNLOAD_CLIENT=qbittorrent
DL_HOST=192.168.1.100
DL_PORT=8080
DL_USERNAME=admin
DL_PASSWORD=adminpass
DL_CATEGORY=Audiobookbay-Audiobooks
# SAVE_PATH_BASE is a STAGING folder, not the final library. The agent watches
# this same path (INPUT_DIR below) and organizes/tags/renames completed
# audiobooks into LIBRARY_DIR, which is what Audiobookshelf should scan.
SAVE_PATH_BASE=/downloads
DL_URL=

# Real-Debrid Settings
# Set DOWNLOAD_CLIENT=realdebrid to use these
RD_AUTH_MODE=oauth
RD_BASE_CLIENT_ID=X245A4XAIBGVM
RD_API_TOKEN=
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_ACCESS_TOKEN=
RD_REFRESH_TOKEN=
RD_DOWNLOADS_DIR=/downloads
RD_MIN_FILE_SIZE_MB=25
RD_EXCLUDE_EXTENSIONS=.nfo,.txt,.exe,.iso,.lnk
RD_POLL_INTERVAL_SEC=5
RD_MAX_WAIT_SEC=900

# Navigation Link (optional)
NAV_LINK_NAME=Audiobookshelf
NAV_LINK_URL=http://192.168.1.100:13378

# Agent Settings (organizes/tags/renames completed downloads into the library)
INPUT_DIR=/downloads
LIBRARY_DIR=/audiobooks
FAILED_DIR=/failed
WORK_DIR=/work
LOG_LEVEL=INFO
# Picard is a GUI app with no reliable headless mode; leave disabled unless you know what you're doing.
ENABLE_PICARD=false
# Optional LLM-assisted title/author decisions (via Ollama). Off by default.
ENABLE_LLM=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=45
LLM_MIN_CONFIDENCE=0.8
# Optional: trigger an Audiobookshelf library scan after organizing a book
ENABLE_AUDIOBOOKSHELF_SCAN=false
AUDIOBOOKSHELF_URL=http://audiobookshelf:80
AUDIOBOOKSHELF_TOKEN=

# Torznab API Settings
TORZNAB_API_KEY=your-secret-api-key-here
TORZNAB_TITLE=AudiobookBay Automated
TORZNAB_DESCRIPTION=AudiobookBay search via Torznab API

# Development Settings
FLASK_DEBUG=false
DEV_PORT=5079
